# 이 파일을 복사해 .env로 만들고 실제 값을 채워 넣는다.
# .env는 .gitignore에 포함되어 있으므로 절대 커밋하지 않는다.

# --- AWS S3 (원본/가공 데이터 저장) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET_NAME=

# --- MySQL (segment_dim, <topic>_agg, dashboard_registry 저장) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# --- 서울시 실시간 도시데이터 API (data.seoul.go.kr, 실시간 상권 유동인구 주제) ---
# 개발 중엔 서울시 제공 샘플키 사용 (광화문·덕수궁 지역만 조회 가능).
# 실제 키 발급 후 이 값만 교체하면 됨.
SEOUL_OPENAPI_KEY=

# 수집 대상 장소는 여기서 관리하지 않는다. foot_traffic_places 테이블
# (python -m src.db.seeds.seed_foot_traffic_places로 시드)의 is_active 컬럼으로 관리한다 -
# API가 자유 장소 조회를 지원하지 않고 121개 고정 목록만 지원하기 때문.

# --- 공통 ---
# 데이터 시간 기준은 무조건 Asia/Seoul. 서버/DB 세션 타임존이 다르면
# 집계 시각(created_at 등)이 어긋날 수 있어 명시적으로 고정한다.
APP_TIMEZONE=Asia/Seoul
