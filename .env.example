# 이 파일을 복사해 .env로 만들고 실제 값을 채워 넣는다.
# .env는 .gitignore에 포함되어 있으므로 절대 커밋하지 않는다.

# --- AWS S3 (원본/가공 데이터 저장) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET_NAME=

# --- MySQL (segment_dim, <topic>_agg, dashboard_registry 저장) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# --- 공통 ---
# 데이터 시간 기준은 무조건 Asia/Seoul. 서버/DB 세션 타임존이 다르면
# 집계 시각(created_at 등)이 어긋날 수 있어 명시적으로 고정한다.
APP_TIMEZONE=Asia/Seoul
